  "nodes": {
    "c2_b1": {
      "bg": "classroom_e",
      "anim": "blackout",
      "page": true,
      "lines": [
        {
          "type": "narration",
          "text": "闹钟响的时候，我以为是周一。"
        },
        {
          "type": "narration",
          "text": "可手机屏幕上，日期还停在昨天。时间，一分钟都没往前走。"
        },
        {
          "type": "inner",
          "text": "（……怎么回事？）"
        },
        {
          "type": "narration",
          "text": "书包还在床头，那张写着名字的名单，又出现了。"
        },
        {
          "type": "narration",
          "text": "红笔划痕比昨天更长，背面那行小字还在——「明天，别忘了带笔。」"
        },
        {
          "type": "narration",
          "text": "我盯着那行字，盯了很久。窗外是灰的，一片云都不动。"
        },
        {
          "type": "narration",
          "text": "第二章 · 混乱"
        }
      ],
      "next": "c2_pressure",
      "fx": [
        {
          "type": "overlay",
          "text": "第 二 章",
          "x": 50,
          "y": 40,
          "size": 30,
          "hold": 1800
        }
      ]
    },
    "c2_pressure": {
      "bg": "classroom_e",
      "anim": "heartbeat",
      "fx": [
        {
          "type": "heartbeat"
        },
        {
          "type": "vignette",
          "dur": 2000
        }
      ],
      "lines": [
        {
          "type": "narration",
          "text": "我坐起来，头很沉。像有个人在脑子里，用指节一下一下敲。"
        },
        {
          "type": "inner",
          "text": "（昨天那些事……名单、程老师、梦里那句“明天见”……）"
        },
        {
          "type": "inner",
          "text": "（想不清楚。越想，越乱。）"
        },
        {
          "type": "narration",
          "text": "我扶着墙站起来。手在抖，不知道是冷，还是别的什么。"
        },
        {
          "type": "narration",
          "text": "压力太大了。大到连呼吸，都得提醒自己一下一下来。"
        }
      ],
      "effects": {
        "san": 4
      },
      "next": "c2_hallucination1"
    },
    "c2_hallucination1": {
      "bg": "corridor_e",
      "sprite": "chengli_normal",
      "anim": "flicker",
      "fx": [
        {
          "type": "glitch"
        },
        {
          "type": "vignette",
          "dur": 1800
        }
      ],
      "lines": [
        {
          "type": "narration",
          "text": "我拉开房门。走廊尽头，站着一个人。"
        },
        {
          "type": "narration",
          "text": "蓝灰色裙子，背对着我，站在光里。"
        },
        {
          "type": "inner",
          "text": "（程……程老师？）"
        },
        {
          "type": "narration",
          "text": "她慢慢转过身。是程丽。"
        },
        {
          "type": "dialogue",
          "speaker": "程丽",
          "emo": "轻",
          "text": "你醒了。"
        }
      ],
      "effects": {
        "san": 5
      },
      "next": "c2_hallucination2"
    },
    "c2_hallucination2": {
      "bg": "corridor_e",
      "sprite": "chengli_smile",
      "anim": "glitch",
      "fx": [
        {
          "type": "glitch"
        },
        {
          "type": "shake"
        },
        {
          "type": "invert",
          "dur": 200
        },
        {
          "type": "spriteShake",
          "dur": 700
        },
        {
          "type": "spriteGlitch",
          "dur": 700
        }
      ],
      "lines": [
        {
          "type": "narration",
          "text": "我还没来得及说话，她的脸——闪了一下。"
        },
        {
          "type": "narration",
          "text": "像老式电视的信号不好。"
        },
        {
          "type": "dialogue",
          "speaker": "程丽",
          "emo": "裂",
          "text": "你 又 忘 了 。"
        },
        {
          "type": "narration",
          "text": "她的身影在走廊里疯狂闪烁，一会儿近，一会儿远。"
        },
        {
          "type": "narration",
          "text": "蓝灰色的裙子，一会儿是干净的颜色，一会儿染着暗红。"
        },
        {
          "type": "inner",
          "text": "（不对……这不是真的。这不是真的——）"
        }
      ],
      "effects": {
        "san": 8
      },
      "next": "c2_hallucination3"
    },
    "c2_hallucination3": {
      "bg": "corridor_e",
      "sprite": "chengli_angry",
      "anim": "shake",
      "fx": [
        {
          "type": "glitch",
          "dur": 900
        },
        {
          "type": "flashword",
          "text": "明 天 见",
          "x": 50,
          "y": 34,
          "size": 34
        },
        {
          "type": "shake"
        },
        {
          "type": "spriteGlitch",
          "dur": 900
        }
      ],
      "lines": [
        {
          "type": "narration",
          "text": "她朝我走近。一步，两步。每一步，身影都在抖。"
        },
        {
          "type": "dialogue",
          "speaker": "程丽",
          "emo": "失真",
          "text": "明天见。明天见。明天——"
        },
        {
          "type": "narration",
          "text": "声音叠在一起，一层压着一层，像有很多个她同时在说话。"
        },
        {
          "type": "inner",
          "text": "（我捂住了耳朵。）"
        },
        {
          "type": "narration",
          "text": "再抬头的时候——"
        },
        {
          "type": "narration",
          "text": "走廊空了。"
        }
      ],
      "effects": {
        "san": 10
      },
      "next": "c2_hallucination4"
    },
    "c2_hallucination4": {
      "bg": "corridor_e",
      "sprite": "",
      "anim": "blackout",
      "fx": [
        {
          "type": "whisper",
          "lines": [
            "这 不 是 真 的",
            "这 不 是 真 的",
            "这 不 是 真 的"
          ],
          "gap": 600
        },
        {
          "type": "vignette",
          "dur": 2200
        }
      ],
      "lines": [
        {
          "type": "narration",
          "text": "我靠着墙，喘气。走廊的灯，一下一下地亮。"
        },
        {
          "type": "narration",
          "text": "哪里还有什么程丽。从头到尾，只有我一个人站在这儿。"
        },
        {
          "type": "inner",
          "text": "（……是我自己看见的。）"
        },
        {
          "type": "inner",
          "text": "（压力太大，出现幻觉了。）"
        },
        {
          "type": "narration",
          "text": "我低下头。手心里，全是汗。"
        },
        {
          "type": "narration",
          "text": "可就在手心的汗里，我摸到了一样东西——一支笔。"
        },
        {
          "type": "narration",
          "text": "黑色的，笔身上刻着一行小字：「别忘了带笔。」"
        },
        {
          "type": "inner",
          "text": "（我……什么时候拿的这支笔？）"
        }
      ],
      "effects": {
        "san": 6,
        "clue": 1
      },
      "next": "c2_after_hallu"
    },
    "c2_after_hallu": {
      "bg": "corridor_e",
      "anim": "none",
      "lines": [
        {
          "type": "narration",
          "text": "我攥着那支笔，站了很久。"
        },
        {
          "type": "inner",
          "text": "（幻觉也好，真的也好。今天，我还得去学校。）"
        },
        {
          "type": "narration",
          "text": "我背起书包，推开门。"
        },
        {
          "type": "narration",
          "text": "门外，是天亮。"
        }
      ],
      "next": "c2_road"
    },
    "c2_road": {
      "bg": "school_gate_e",
      "anim": "fade",
      "lines": [
        {
          "type": "narration",
          "text": "上学路安静得过分。"
        },
        {
          "type": "narration",
          "text": "路边的早点摊没开，公交站没有人，连鸟叫都没有。"
        },
        {
          "type": "inner",
          "text": "（像全世界都被按了暂停，只有我一个人在走。）"
        },
        {
          "type": "narration",
          "text": "我摸了摸口袋。那支笔还在。"
        }
      ],
      "next": "c2_enter_school"
    },
    "c2_enter_school": {
      "bg": "school_gate_e",
      "anim": "flicker",
      "lines": [
        {
          "type": "narration",
          "text": "校门口的大铁门开着。"
        },
        {
          "type": "narration",
          "text": "今天有学生了。三三两两，低着头往里走。"
        },
        {
          "type": "narration",
          "text": "没有人说话。脚步声齐齐的，像被谁数着拍子。"
        },
        {
          "type": "inner",
          "text": "（昨天……他们也这样吗？）"
        },
        {
          "type": "narration",
          "text": "我跟着人群往里走。公告栏上那张名单还在，我的名字还在第十二个。"
        },
        {
          "type": "narration",
          "text": "红笔的划痕，又长了一点。"
        }
      ],
      "effects": {
        "san": 3
      },
      "next": "c2_class_enter"
    },
    "c2_class_enter": {
      "bg": "classroom_e",
      "anim": "fade",
      "lines": [
        {
          "type": "narration",
          "text": "我推开教室的门。"
        },
        {
          "type": "narration",
          "text": "教室里的光很暗。窗帘拉着，只有讲台上方亮着一盏灯。"
        },
        {
          "type": "narration",
          "text": "班里坐满了人。我们班的同学，一个不少，全在。"
        },
        {
          "type": "narration",
          "text": "可没有一个人抬头。"
        },
        {
          "type": "inner",
          "text": "（他们的脸……）"
        },
        {
          "type": "narration",
          "text": "每一张脸都木着。眼睛睁着，却像蒙了层灰。"
        },
        {
          "type": "narration",
          "text": "我同桌，还是那个盯着课本第一页的女生。"
        },
        {
          "type": "narration",
          "text": "Steamed chicken soup。还是那个词。"
        },
        {
          "type": "inner",
          "text": "（他们好像……被什么东西定住了。跟昨天一模一样。）"
        }
      ],
      "effects": {
        "san": 4
      },
      "next": "c2_take_seat"
    },
    "c2_take_seat": {
      "bg": "classroom_e",
      "anim": "none",
      "lines": [
        {
          "type": "narration",
          "text": "我走到自己的座位坐下。"
        },
        {
          "type": "narration",
          "text": "椅子的温度是凉的。桌面上那道刻痕还在——「别回头。回头就出不去了。」"
        },
        {
          "type": "inner",
          "text": "（……是我自己刻的？）"
        },
        {
          "type": "narration",
          "text": "我抬起头。"
        },
        {
          "type": "narration",
          "text": "讲台前，站着一个人。"
        }
      ],
      "choices": [
        {
          "text": "看讲台上是谁",
          "next": "c2_chengli_appear",
          "effects": {}
        }
      ]
    },
    "c2_chengli_appear": {
      "bg": "classroom_e",
      "sprite": "chengli_normal",
      "anim": "heartbeat",
      "fx": [
        {
